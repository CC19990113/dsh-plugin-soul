{
  "name": "dsh-plugin-soul",
  "version": "0.4.1",
  "description": "A writable, git-versioned self for DeepSeek Harness: persona files injected every turn, a persona-only memory layer, topic-keyed journal→dream promotion gated by your 👍/😑/👎 ratings, whitelisted self-upgrades, and a Settings persona tab.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "persona",
    "soul",
    "identity",
    "self-iteration",
    "dreaming",
    "settings"
  ],
  "license": "MIT",
  "author": "CC19990113",
  "homepage": "https://github.com/CC19990113/dsh-plugin-soul#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CC19990113/dsh-plugin-soul.git"
  },
  "bugs": {
    "url": "https://github.com/CC19990113/dsh-plugin-soul/issues"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "templates",
    "cordis.patch.yml",
    "install.mjs",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node test/smoke.mjs && node test/features.mjs && node test/memory.mjs && node test/ratings.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "*",
    "react": ">=18"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    },
    "compatibility": {
      "dshReleases": {
        "0.2.1-rc.2": "unknown"
      }
    }
  }
}
